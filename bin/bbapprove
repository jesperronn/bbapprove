#!/usr/bin/env bash
# shellcheck shell=bash
# bbapprove — approve and merge eligible Renovate PRs on Bitbucket Server (dry-run unless --apply).

set -euo pipefail

BBAPPROVE_AUTHOR_EMAIL="${BBAPPROVE_AUTHOR_EMAIL:-renovate-bot@example.com}"
SCRIPT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
# Disallow list: one dependency per line in this file ('#' comments and blank lines ignored);
# --disallow / BBAPPROVE_DISALLOW (comma-separated) add to it. Case-insensitive substrings.
BBAPPROVE_DISALLOW_FILE="${BBAPPROVE_DISALLOW_FILE:-$(dirname "$SCRIPT_PATH")/../disallow.txt}"
BBAPPROVE_DISALLOW="${BBAPPROVE_DISALLOW:-}"
BBAPPROVE_JOBS="${BBAPPROVE_JOBS:-$( (nproc || sysctl -n hw.ncpu || echo 4) 2>/dev/null | head -n1)}"
# Provider adapter: gh-style CLI (auth token | pr list|view|review|merge). Only it talks to the forge.
BBAPPROVE_ADAPTER="${BBAPPROVE_ADAPTER:-$(dirname "$SCRIPT_PATH")/../adapters/bitbucket}"
export BBAPPROVE_AUTHOR_EMAIL BBAPPROVE_DISALLOW_FILE BBAPPROVE_JOBS BBAPPROVE_ADAPTER
BBAPPROVE_TOKEN="${BBAPPROVE_TOKEN:-}"
BBAPPROVE_APPLY="${BBAPPROVE_APPLY:-0}"
BBAPPROVE_INTERACTIVE=0
BBAPPROVE_TARGETS=()

# Colors: only on a TTY, never with NO_COLOR; FORCE_COLOR=1 forces them on.
setup_colors() {
  C_RESET="" C_BOLD="" C_DIM="" C_RED="" C_GREEN="" C_YELLOW="" C_CYAN=""
  if [[ -z "${NO_COLOR:-}" && ( -t 1 || -n "${FORCE_COLOR:-}" ) ]]; then
    C_RESET=$'\033[0m' C_BOLD=$'\033[1m' C_DIM=$'\033[2m' C_RED=$'\033[31m'
    C_GREEN=$'\033[32m' C_YELLOW=$'\033[33m' C_CYAN=$'\033[36m'
  fi
}
setup_colors

# Colorize help text: title bold, section headings and flags cyan, env names yellow, rule bullets dim.
colorize_usage() {
  if [[ -z "$C_RESET" ]]; then cat; return; fi
  sed -E \
    -e "1s/^(.*)$/${C_BOLD}\\1${C_RESET}/" \
    -e "s/^(Usage:)/${C_BOLD}${C_CYAN}\\1${C_RESET}/" \
    -e "s/^(A PR is eligible when ALL hold:)/${C_BOLD}${C_CYAN}\\1${C_RESET}/" \
    -e "s/^(Env:)(.*)$/${C_BOLD}${C_CYAN}\\1${C_RESET}${C_YELLOW}\\2${C_RESET}/" \
    -e "s/(^|[ [|])(--?[a-z]+)/\\1${C_GREEN}\\2${C_RESET}/g" \
    -e "s/^(Token falls back.*)$/${C_DIM}\\1${C_RESET}/"
}

usage() {
  colorize_usage <<'USAGE'
bbapprove — approve and merge Renovate PRs on Bitbucket Server.

Usage: bbapprove [-i|--interactive] [--apply] [--disallow a,b] [--token T] [PR_URL...]

With no PR_URL, every open PR where you are a reviewer is considered.
-i opens an fzf picker of eligible PRs; the PRs you pick are approved and merged.
Without --apply (or -i) nothing is changed; eligibility is only reported.

Each PR line ends with: build, SonarQube quality gate, approval (✗ = needs work), 💬 comments, ☐ open tasks.

A PR is eligible when ALL hold:
  - author email is renovate-bot@example.com
  - title starts with "chore(deps):" or "fix(deps):"
  - title does not mention a disallowed dependency (disallow.txt, --disallow)
  - update is minor/patch/digest (title "to vN" only, or branch renovate/major-*, is major)

Disallow list: disallow.txt next to bin/ (one dependency per line, # comments); --disallow adds more.
Forge access goes through the adapter (adapters/bitbucket); its requests time out (connect 2.7s, total 3.5s)
and PR fetches/approvals run in parallel (one job per CPU core).

Env: BBAPPROVE_AUTHOR_EMAIL, BBAPPROVE_DISALLOW, BBAPPROVE_DISALLOW_FILE, BBAPPROVE_JOBS, BBAPPROVE_ADAPTER, BBAPPROVE_TOKEN;
     adapter: BBAPPROVE_BASE_URL, BBAPPROVE_MERGE_RETRIES, BBAPPROVE_RETRY_SLEEP.
Token falls back to 1Password item BITBUCKET_TOKEN (same as bbpr).
USAGE
}

# status WORD COLOR... -> WORD colored, padded to 8 columns so the PR column lines up.
status() {
  local word="$1"; shift
  local pad=$(( 8 - ${#word} )); (( pad < 0 )) && pad=0
  printf '%s%s%s%*s' "$*" "$word" "$C_RESET" "$pad" ""
}

# pr_label KEY REPO ID TITLE -> KEY (dim cyan) / (dim) REPO (cyan) #ID (bold) TITLE
pr_label() {
  local R="$C_RESET"
  printf '%s%s%s%s/%s%s%s%s%s#%s%s %s' \
    "$C_DIM$C_CYAN" "$1" "$R" "$C_DIM" "$R" "$C_CYAN" "$2" "$R" "$C_BOLD" "$3" "$R" "$4"
}

log() { printf '%s\n' "$*"; }
err() { printf '%s\n' "$*" >&2; }

fetch_token() {
  [[ -n "$BBAPPROVE_TOKEN" ]] || BBAPPROVE_TOKEN="$("$BBAPPROVE_ADAPTER" auth token)" || return 1
}

# disallow_items -> one lowercase item per line: file entries (no '#' lines/blanks) then comma-separated BBAPPROVE_DISALLOW
disallow_items() {
  local item
  if [[ -f "$BBAPPROVE_DISALLOW_FILE" ]]; then
    grep -vE '^[[:space:]]*(#|$)' "$BBAPPROVE_DISALLOW_FILE" || true
  fi
  tr ',' '\n' <<<"$BBAPPROVE_DISALLOW"
}

# eligibility: prints reason and returns 1 when not eligible
check_eligible() {
  local pr="$1" email title branch lower_title item
  email="$(jq -r '.author.email' <<<"$pr")"
  title="$(jq -r '.title' <<<"$pr")"
  branch="$(jq -r '.headBranch' <<<"$pr")"
  if [[ "$email" != "$BBAPPROVE_AUTHOR_EMAIL" ]]; then echo "author '$email' is not the renovate bot"; return 1; fi
  if [[ ! "$title" =~ ^(chore|fix)\(deps\):\  ]]; then echo "subject does not start with chore(deps): or fix(deps):"; return 1; fi
  lower_title="$(tr '[:upper:]' '[:lower:]' <<<"$title")"
  while IFS= read -r item; do
    item="$(tr '[:upper:]' '[:lower:]' <<<"${item//[[:space:]]/}")"
    [[ -n "$item" && "$lower_title" == *"$item"* ]] && { echo "disallowed dependency '$item'"; return 1; }
  done < <(disallow_items)
  if [[ "$branch" == renovate/major-* || "$title" =~ \ to\ v?[0-9]+\ *(\(.*\))?$ ]]; then echo "major update"; return 1; fi
  if [[ "$(jq -r '.approvedByMe' <<<"$pr")" == "true" ]]; then echo "already approved by me"; return 1; fi
  return 0
}

pr_label_of() { # normalized PR json -> label
  pr_label "$(jq -r '.project' <<<"$1")" "$(jq -r '.repo' <<<"$1")" "$(jq -r '.number' <<<"$1")" "$(jq -r '.title' <<<"$1")"
}

# checks_glyphs PR -> "build quality-gate approval comments", e.g. "✓ ✓ – 💬2 ☐1" (✓ ok, ✗ failed/needs work, … running, – none)
checks_glyphs() {
  local b q a c t
  read -r b q a c t < <(jq -r '[
    ({passed:"ok",failed:"bad",running:"run"}[.build // "none"] // "none"),
    ({passed:"ok",failed:"bad"}[.qualityGate // "unknown"] // "none"),
    (if (.needsWork // 0) > 0 then "bad" elif (.approvals // 0) > 0 then "ok" else "none" end),
    (.commentCount // 0), (.openTasks // 0)] | @tsv' <<<"$1")
  local out="" w g
  for w in "$b" "$q" "$a"; do
    case "$w" in
      ok) g="${C_GREEN}✓${C_RESET}" ;; bad) g="${C_RED}✗${C_RESET}" ;; run) g="${C_YELLOW}…${C_RESET}" ;; *) g="${C_DIM}–${C_RESET}" ;;
    esac
    out+="$g "
  done
  printf '%s💬%s ☐%s' "$out" "$c" "$t"
}

process_pr() { # normalized PR json
  local pr="$1" label reason
  label="$(pr_label_of "$pr")"
  if ! reason="$(check_eligible "$pr")"; then log "$(status SKIP "$C_YELLOW") $label ${C_DIM}— $reason${C_RESET}  $(checks_glyphs "$pr")"; return 0; fi
  if (( ! BBAPPROVE_APPLY )); then log "$(status ELIGIBLE "$C_GREEN") $label ${C_DIM}(dry-run)${C_RESET}  $(checks_glyphs "$pr")"; return 0; fi
  act_on_pr "$pr"
}

act_on_pr() { # normalized PR json: approve, then merge (the adapter handles stale-version retries)
  local pr="$1" url label msg
  url="$(jq -r '.url' <<<"$pr")"
  label="$(pr_label_of "$pr")"
  if ! msg="$("$BBAPPROVE_ADAPTER" pr review "$url" --approve 2>&1)"; then log "$(status FAIL "$C_RED") $label — $msg"; return 0; fi
  if msg="$("$BBAPPROVE_ADAPTER" pr merge "$url" 2>&1)"; then log "$(status MERGED "${C_GREEN}${C_BOLD}") $label"; return 0; fi
  log "${C_RED}APPROVED, NOT MERGED${C_RESET} $label — $msg"
}

# fzf multi-select over eligible PRs (sorted by repo, all preselected); approves+merges the picks.
interactive_run() { # PR json...
  command -v fzf >/dev/null || { err "fzf is required for --interactive"; return 1; }
  local pr reason lines="" i=0 elig=() picked line idx
  for pr in "$@"; do
    if reason="$(check_eligible "$pr")"; then
      elig+=("$pr")
      lines+="$i"$'\t'"$(jq -r '"\(.project)/\(.repo)#\(.number)\t\(.title)"' <<<"$pr")"$'\n'
      i=$((i + 1))
    fi
  done
  if (( ${#elig[@]} == 0 )); then log "No eligible PRs."; return 0; fi
  picked="$(printf '%s' "$lines" | sort -t$'\t' -k2,2 -s | fzf --multi --delimiter=$'\t' --with-nth=2.. \
    --bind 'start:select-all,ctrl-a:select-all,ctrl-d:deselect-all' \
    --header 'TAB toggle · ctrl-a all · ctrl-d none · ENTER approve+merge selected · ESC cancel' \
    --prompt 'approve> ')" || { log "Cancelled."; return 0; }
  [[ -n "$picked" ]] || { log "Nothing selected."; return 0; }
  local chosen=()
  while IFS= read -r line; do
    idx="${line%%$'\t'*}"
    chosen+=("${elig[$idx]}")
  done <<<"$picked"
  par_each __act "${chosen[@]}"
}

# par_each SUBCOMMAND ARG... -> runs "$SCRIPT_PATH SUBCOMMAND ARG" per arg, up to BBAPPROVE_JOBS at once.
par_each() {
  local sub="$1"; shift
  (( $# )) || return 0
  printf '%s\0' "$@" | xargs -0 -n1 -P "$BBAPPROVE_JOBS" "$SCRIPT_PATH" "$sub"
}

main() {
  # Internal subcommands, run by par_each in child processes (token and settings come via env).
  case "${1:-}" in
    __fetch) "$BBAPPROVE_ADAPTER" pr view "$2"; return ;;
    __process) process_pr "$2"; return ;;
    __act) act_on_pr "$2"; return ;;
  esac
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage; return 0 ;;
      --apply) BBAPPROVE_APPLY=1; shift ;;
      -i|--interactive) BBAPPROVE_INTERACTIVE=1; shift ;;
      --disallow) BBAPPROVE_DISALLOW="$2"; shift 2 ;;
      --token) BBAPPROVE_TOKEN="$2"; shift 2 ;;
      -*) err "Unknown option: $1"; C_RESET="" usage >&2; return 2 ;;
      *) BBAPPROVE_TARGETS+=("$1"); shift ;;
    esac
  done
  command -v jq >/dev/null || { err "jq is required"; return 1; }
  fetch_token
  export BBAPPROVE_TOKEN BBAPPROVE_APPLY BBAPPROVE_DISALLOW

  local prs=() page
  if (( ${#BBAPPROVE_TARGETS[@]} )); then
    while IFS= read -r page; do prs+=("$page"); done < <(par_each __fetch "${BBAPPROVE_TARGETS[@]}")
    (( ${#prs[@]} == ${#BBAPPROVE_TARGETS[@]} )) || return 1
  else
    page="$("$BBAPPROVE_ADAPTER" pr list --reviewer @me --state open)" || return 1
    while IFS= read -r page; do prs+=("$page"); done < <(jq -c '.[]' <<<"$page")
  fi

  local pr
  if (( BBAPPROVE_INTERACTIVE )); then interactive_run ${prs[@]+"${prs[@]}"}; return; fi
  if (( BBAPPROVE_APPLY )); then
    par_each __process ${prs[@]+"${prs[@]}"}   # approve/merge calls hit the network: run in parallel
  else
    for pr in ${prs[@]+"${prs[@]}"}; do process_pr "$pr"; done   # dry run is local only: keep input order
  fi
  (( BBAPPROVE_APPLY )) || log "Dry run — pass --apply to approve and merge."
}

main "$@"
