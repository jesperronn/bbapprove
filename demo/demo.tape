# VHS tape for the README animation. Run with: bin/demo record (writes demo/demo.gif).
Output demo/demo.gif

Set Shell "bash"
Set FontSize 15
Set Width 1100
Set Height 620
Set Padding 14
Set TypingSpeed 45ms

Type "bin/demo list"
Sleep 800ms
Enter
Sleep 3s

Type "clear"
Enter
Type "bin/demo run"
Enter
Sleep 3s

Type "j"
Sleep 800ms
Type "a"
Sleep 4s

Type "?"
Sleep 2s
Type "q"
Sleep 1s
