#!/usr/bin/env bash
# shellcheck shell=bash
# bbapprove — approve and merge eligible Renovate PRs on Bitbucket Server (dry-run unless --apply).

set -euo pipefail

BBAPPROVE_BASE_URL="${BBAPPROVE_BASE_URL:-https://bitbucket.example.com}"
BBAPPROVE_AUTHOR_EMAIL="${BBAPPROVE_AUTHOR_EMAIL:-renovate-bot@example.com}"
BBAPPROVE_DISALLOW="${BBAPPROVE_DISALLOW:-some-library}"   # comma-separated, case-insensitive substrings
BBAPPROVE_TOKEN="${BBAPPROVE_TOKEN:-}"
BBAPPROVE_APPLY=0
BBAPPROVE_INTERACTIVE=0
BBAPPROVE_MERGE_RETRIES="${BBAPPROVE_MERGE_RETRIES:-4}"
BBAPPROVE_RETRY_SLEEP="${BBAPPROVE_RETRY_SLEEP:-2}"
BBAPPROVE_TARGETS=()

# Colors: only on a TTY, never with NO_COLOR; FORCE_COLOR=1 forces them on.
setup_colors() {
  C_RESET="" C_BOLD="" C_DIM="" C_RED="" C_GREEN="" C_YELLOW="" C_CYAN=""
  if [[ -z "${NO_COLOR:-}" && ( -t 1 || -n "${FORCE_COLOR:-}" ) ]]; then
    C_RESET=$'\033[0m' C_BOLD=$'\033[1m' C_DIM=$'\033[2m' C_RED=$'\033[31m'
    C_GREEN=$'\033[32m' C_YELLOW=$'\033[33m' C_CYAN=$'\033[36m'
  fi
}
setup_colors

# Colorize help text: title bold, section headings and flags cyan, env names yellow, rule bullets dim.
colorize_usage() {
  if [[ -z "$C_RESET" ]]; then cat; return; fi
  sed -E \
    -e "1s/^(.*)$/${C_BOLD}\\1${C_RESET}/" \
    -e "s/^(Usage:)/${C_BOLD}${C_CYAN}\\1${C_RESET}/" \
    -e "s/^(A PR is eligible when ALL hold:)/${C_BOLD}${C_CYAN}\\1${C_RESET}/" \
    -e "s/^(Env:)(.*)$/${C_BOLD}${C_CYAN}\\1${C_RESET}${C_YELLOW}\\2${C_RESET}/" \
    -e "s/(^|[ [|])(--?[a-z]+)/\\1${C_GREEN}\\2${C_RESET}/g" \
    -e "s/^(Token falls back.*)$/${C_DIM}\\1${C_RESET}/"
}

usage() {
  colorize_usage <<'USAGE'
bbapprove — approve and merge Renovate PRs on Bitbucket Server.

Usage: bbapprove [-i|--interactive] [--apply] [--disallow a,b] [--token T] [PR_URL...]

With no PR_URL, every open PR where you are a reviewer is considered.
-i opens an fzf picker of eligible PRs; the PRs you pick are approved and merged.
Without --apply (or -i) nothing is changed; eligibility is only reported.

A PR is eligible when ALL hold:
  - author email is renovate-bot@example.com
  - title starts with "chore(deps):" or "fix(deps):"
  - title does not mention a disallowed dependency (default: some-library)
  - update is minor/patch/digest (title "to vN" only, or branch renovate/major-*, is major)

Env: BBAPPROVE_MERGE_RETRIES, BBAPPROVE_RETRY_SLEEP, BBAPPROVE_BASE_URL, BBAPPROVE_AUTHOR_EMAIL, BBAPPROVE_DISALLOW, BBAPPROVE_TOKEN.
Token falls back to 1Password item BITBUCKET_TOKEN (same as bbpr).
USAGE
}

# status WORD COLOR... -> WORD colored, padded to 8 columns so the PR column lines up.
status() {
  local word="$1"; shift
  local pad=$(( 8 - ${#word} )); (( pad < 0 )) && pad=0
  printf '%s%s%s%*s' "$*" "$word" "$C_RESET" "$pad" ""
}

# pr_label KEY REPO ID TITLE -> KEY (dim cyan) / (dim) REPO (cyan) #ID (bold) TITLE
pr_label() {
  local R="$C_RESET"
  printf '%s%s%s%s/%s%s%s%s%s#%s%s %s' \
    "$C_DIM$C_CYAN" "$1" "$R" "$C_DIM" "$R" "$C_CYAN" "$2" "$R" "$C_BOLD" "$3" "$R" "$4"
}

log() { printf '%s\n' "$*"; }
err() { printf '%s\n' "$*" >&2; }

fetch_token() {
  if [[ -z "$BBAPPROVE_TOKEN" ]] && command -v op >/dev/null 2>&1; then
    err "${C_DIM}Waiting for 1Password: op item get BITBUCKET_TOKEN${C_RESET}"
    BBAPPROVE_TOKEN="$(op item get BITBUCKET_TOKEN --fields label=token --reveal)" || BBAPPROVE_TOKEN=""
  fi
  [[ -n "$BBAPPROVE_TOKEN" ]] || { err "No token: use --token, BBAPPROVE_TOKEN or 1Password (op)."; return 1; }
}

LAST_CODE=""
api() { # method endpoint [data] -> body on stdout, http code in LAST_CODE (call without subshell via api_to)
  local method="$1" endpoint="$2" data="${3:-}" out
  local args=(-sS -w $'\n%{http_code}' -X "$method" -H "Authorization: Bearer $BBAPPROVE_TOKEN" -H "Accept: application/json")
  [[ -n "$data" ]] && args+=(-H "Content-Type: application/json" -d "$data")
  out="$(curl "${args[@]}" "$BBAPPROVE_BASE_URL$endpoint")"
  LAST_CODE="$(printf '%s' "$out" | tail -n1)"
  API_BODY="$(printf '%s' "$out" | sed '$d')"
}

# eligibility: prints reason and returns 1 when not eligible
check_eligible() {
  local pr="$1" email title branch lower_title item
  email="$(jq -r '.author.user.emailAddress // ""' <<<"$pr")"
  title="$(jq -r '.title' <<<"$pr")"
  branch="$(jq -r '.fromRef.displayId // ""' <<<"$pr")"
  if [[ "$email" != "$BBAPPROVE_AUTHOR_EMAIL" ]]; then echo "author '$email' is not the renovate bot"; return 1; fi
  if [[ ! "$title" =~ ^(chore|fix)\(deps\):\  ]]; then echo "subject does not start with chore(deps): or fix(deps):"; return 1; fi
  lower_title="$(tr '[:upper:]' '[:lower:]' <<<"$title")"
  IFS=',' read -ra items <<<"$BBAPPROVE_DISALLOW"
  for item in "${items[@]}"; do
    item="$(tr '[:upper:]' '[:lower:]' <<<"${item// /}")"
    [[ -n "$item" && "$lower_title" == *"$item"* ]] && { echo "disallowed dependency '$item'"; return 1; }
  done
  if [[ "$branch" == renovate/major-* || "$title" =~ \ to\ v?[0-9]+\ *(\(.*\))?$ ]]; then echo "major update"; return 1; fi
  if [[ -n "${ME:-}" && "$(jq -r --arg me "$ME" '[.participants[]? | select(.user.slug==$me and .status=="APPROVED")] | length' <<<"$pr")" -gt 0 ]]; then
    echo "already approved by me"; return 1
  fi
  return 0
}

process_pr() { # PR json
  local pr="$1" key repo id version label reason
  key="$(jq -r '.toRef.repository.project.key' <<<"$pr")"
  repo="$(jq -r '.toRef.repository.slug' <<<"$pr")"
  id="$(jq -r '.id' <<<"$pr")"
  version="$(jq -r '.version' <<<"$pr")"
  label="$(pr_label "$key" "$repo" "$id" "$(jq -r '.title' <<<"$pr")")"
  if ! reason="$(check_eligible "$pr")"; then log "$(status SKIP "$C_YELLOW") $label ${C_DIM}— $reason${C_RESET}"; return 0; fi
  if (( ! BBAPPROVE_APPLY )); then log "$(status ELIGIBLE "$C_GREEN") $label ${C_DIM}(dry-run)${C_RESET}"; return 0; fi
  act_on_pr "$pr"
}

act_on_pr() { # PR json: approve, then merge with retries
  local pr="$1" key repo id version label
  key="$(jq -r '.toRef.repository.project.key' <<<"$pr")"
  repo="$(jq -r '.toRef.repository.slug' <<<"$pr")"
  id="$(jq -r '.id' <<<"$pr")"
  version="$(jq -r '.version' <<<"$pr")"
  label="$(pr_label "$key" "$repo" "$id" "$(jq -r '.title' <<<"$pr")")"
  local base="/rest/api/1.0/projects/$key/repos/$repo/pull-requests/$id"
  api POST "$base/approve"
  if [[ "$LAST_CODE" != 2* ]]; then log "$(status FAIL "$C_RED") $label — approve HTTP $LAST_CODE"; return 0; fi
  # Re-fetch the PR right before merging: earlier merges in the same repo move the
  # target branch and bump the PR version, so the one read at startup goes stale.
  local attempt=0 fresh
  while :; do
    attempt=$((attempt + 1))
    api GET "$base"
    fresh="$(jq -r '.version // empty' <<<"$API_BODY" 2>/dev/null || true)"
    [[ -n "$fresh" ]] || fresh="$version"
    api POST "$base/merge?version=$fresh" "{\"version\":$fresh}"
    if [[ "$LAST_CODE" == 2* ]]; then log "$(status MERGED "${C_GREEN}${C_BOLD}") $label"; return 0; fi
    if [[ "$LAST_CODE" == 409 && "$API_BODY" == *"out-of-date"* ]] && (( attempt < BBAPPROVE_MERGE_RETRIES )); then
      sleep "$BBAPPROVE_RETRY_SLEEP"; continue
    fi
    break
  done
  log "${C_RED}APPROVED, NOT MERGED${C_RESET} $label — merge HTTP $LAST_CODE: $(jq -r '[.errors[]?.message] | join("; ")' <<<"$API_BODY" 2>/dev/null || true)"
}

# fzf multi-select over eligible PRs (sorted by repo, all preselected); approves+merges the picks.
interactive_run() { # PR json...
  command -v fzf >/dev/null || { err "fzf is required for --interactive"; return 1; }
  local pr reason lines="" i=0 elig=() picked line idx
  for pr in "$@"; do
    if reason="$(check_eligible "$pr")"; then
      elig+=("$pr")
      lines+="$i"$'\t'"$(jq -r '"\(.toRef.repository.project.key)/\(.toRef.repository.slug)#\(.id)\t\(.title)"' <<<"$pr")"$'\n'
      i=$((i + 1))
    fi
  done
  if (( ${#elig[@]} == 0 )); then log "No eligible PRs."; return 0; fi
  picked="$(printf '%s' "$lines" | sort -t$'\t' -k2,2 -s | fzf --multi --delimiter=$'\t' --with-nth=2.. \
    --bind 'start:select-all,ctrl-a:select-all,ctrl-d:deselect-all' \
    --header 'TAB toggle · ctrl-a all · ctrl-d none · ENTER approve+merge selected · ESC cancel' \
    --prompt 'approve> ')" || { log "Cancelled."; return 0; }
  [[ -n "$picked" ]] || { log "Nothing selected."; return 0; }
  while IFS= read -r line; do
    idx="${line%%$'\t'*}"
    act_on_pr "${elig[$idx]}"
  done <<<"$picked"
}

parse_pr_url() { # url -> "KEY REPO ID"
  if [[ "$1" =~ /projects/([^/]+)/repos/([^/]+)/pull-requests/([0-9]+) ]]; then
    printf '%s %s %s' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
  else
    return 1
  fi
}

main() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage; return 0 ;;
      --apply) BBAPPROVE_APPLY=1; shift ;;
      -i|--interactive) BBAPPROVE_INTERACTIVE=1; shift ;;
      --disallow) BBAPPROVE_DISALLOW="$2"; shift 2 ;;
      --token) BBAPPROVE_TOKEN="$2"; shift 2 ;;
      -*) err "Unknown option: $1"; C_RESET="" usage >&2; return 2 ;;
      *) BBAPPROVE_TARGETS+=("$1"); shift ;;
    esac
  done
  command -v jq >/dev/null || { err "jq is required"; return 1; }
  fetch_token

  api GET "/plugins/servlet/applinks/whoami" || true
  ME=""; [[ "$LAST_CODE" == 200 ]] && ME="$(tr -d '[:space:]' <<<"$API_BODY")"

  local prs=() t parts key repo id start=0 last page
  if (( ${#BBAPPROVE_TARGETS[@]} )); then
    for t in "${BBAPPROVE_TARGETS[@]}"; do
      parts="$(parse_pr_url "$t")" || { err "Not a PR URL: $t"; return 2; }
      read -r key repo id <<<"$parts"
      api GET "/rest/api/1.0/projects/$key/repos/$repo/pull-requests/$id"
      [[ "$LAST_CODE" == 200 ]] || { err "Fetch failed ($LAST_CODE): $t"; return 1; }
      prs+=("$API_BODY")
    done
  else
    while :; do
      api GET "/rest/api/1.0/dashboard/pull-requests?role=REVIEWER&state=OPEN&limit=100&start=$start"
      [[ "$LAST_CODE" == 200 ]] || { err "Dashboard fetch failed ($LAST_CODE)"; return 1; }
      while IFS= read -r page; do prs+=("$page"); done < <(jq -c '.values[]' <<<"$API_BODY")
      last="$(jq -r '.isLastPage' <<<"$API_BODY")"
      [[ "$last" == "true" ]] && break
      start="$(jq -r '.nextPageStart' <<<"$API_BODY")"
    done
  fi

  local pr
  if (( BBAPPROVE_INTERACTIVE )); then interactive_run ${prs[@]+"${prs[@]}"}; return; fi
  for pr in ${prs[@]+"${prs[@]}"}; do process_pr "$pr"; done
  (( BBAPPROVE_APPLY )) || log "Dry run — pass --apply to approve and merge."
}

main "$@"
