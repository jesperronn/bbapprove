#!/usr/bin/env bash
# shellcheck shell=bash
# release — cut a release: changelog, commit, annotated tag, push, then watch the Release workflow
#
# Usage: bin/release [--dry-run] [--yes] [VERSION]
#   VERSION    semver without a leading v: 1.0.0 or 1.0.0-rc.3 (a "-" marks a pre-release). Omitted: taken from
#              `bin/changelog next` (conventional commits since the last tag). Given and different from that
#              suggestion: a one-line note is printed and the release goes on.
#   --dry-run  run the read-only checks and print every step it WOULD take; changes nothing
#   --yes      do not ask before pushing
# Steps: preconditions (on main, clean, not behind origin, tag unused, gh logged in, CHANGELOG
# [Unreleased] not empty) -> bin/lint -> bin/test -> move [Unreleased] under "## [VERSION] - DATE"
# -> commit "docs: changelog for VERSION" -> tag vVERSION -> confirm -> push main and the tag
# -> gh run watch -> print the release URL.
# The release notes stay the hand-written [Unreleased] section; bin/changelog only suggests the version.
# Exit: 0 released (or dry run), 1 failed or declined, 2 usage error, 127 tool missing.
# Env: RELEASE_DATE (default today), BBAPPROVE_RELEASE_RUN_WAIT_SECONDS (default 60; how long to look for
#      the Release workflow run after the push), BBAPPROVE_RELEASE_RUN_POLL_SECONDS (default 3; pause between
#      looks, at least 1). Set the wait to 0 to look once.

set -euo pipefail

SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
  target="$(readlink "$SELF")"
  if [[ "$target" == /* ]]; then SELF="$target"; else SELF="$(dirname "$SELF")/$target"; fi
done
REPO="$(cd "$(dirname "$SELF")/.." && pwd -P)"
# shellcheck source=lib/style.sh
source "$REPO/bin/lib/style.sh"

usage_text() {
  cat <<'USAGE'
Usage: bin/release [--dry-run] [--yes] [VERSION]

VERSION is semver without a leading v, e.g. 1.0.0 or 1.0.0-rc.3 (a "-" marks a pre-release).
  Omitted, it is taken from the conventional commits since the last tag (bin/changelog next); with
  only docs, test or chore commits that fails, so pass VERSION to release anyway. A VERSION that
  differs from the suggestion prints a note and the release goes on.
  --dry-run   run the read-only checks and print every step it would take; changes nothing
  --yes       do not ask before pushing
  -h, --help  this text

Needs a clean main in sync with origin, a filled "## [Unreleased]" in CHANGELOG.md, and gh logged in.
USAGE
}

usage() { usage_text | style_help; }

die() {
  echo "$(paint err 2 "release:") $*" >&2
  exit 1
}

need_tool() {
  local tool="$1" brew_pkg="$2" apt_pkg="${3:-$2}" hint
  command -v "$tool" >/dev/null 2>&1 && return 0
  if [[ "$(uname -s)" == Darwin ]]; then hint="brew install $brew_pkg"; else hint="sudo apt install $apt_pkg"; fi
  echo "release: needs $tool ($hint)" >&2
  exit 127
}

dry=0 yes=0 version=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --dry-run) dry=1 ;;
    --yes | -y) yes=1 ;;
    -*)
      echo "release: unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      [[ -z "$version" ]] || {
        echo "release: only one VERSION allowed" >&2
        exit 2
      }
      version="$1"
      ;;
  esac
  shift
done

semver='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$'
if [[ -n "$version" && ! "$version" =~ $semver ]]; then
  echo "release: not a semver version: $version (expected e.g. 1.0.0 or 1.0.0-rc.3, no leading v)" >&2
  exit 2
fi
today="${RELEASE_DATE:-$(date +%F)}"
wait_s="${BBAPPROVE_RELEASE_RUN_WAIT_SECONDS:-60}"
poll_s="${BBAPPROVE_RELEASE_RUN_POLL_SECONDS:-3}"
[[ "$wait_s" =~ ^[0-9]+$ ]] || die "BBAPPROVE_RELEASE_RUN_WAIT_SECONDS must be a whole number of seconds"
[[ "$poll_s" =~ ^[1-9][0-9]*$ ]] || die "BBAPPROVE_RELEASE_RUN_POLL_SECONDS must be a whole number of seconds, at least 1"

need_tool git git
need_tool gh gh
cd "$REPO"

# The version the conventional commits suggest (bin/changelog next prints vX.Y.Z; exit 3: nothing releasable).
suggest_rc=0
suggest_out="$("$REPO/bin/changelog" next 2>&1)" || suggest_rc=$?
suggested=""
if [[ "$suggest_rc" == 0 && "${suggest_out#v}" =~ $semver ]]; then suggested="${suggest_out#v}"; fi
derived=0
if [[ -z "$version" ]]; then
  if [[ "$suggest_rc" == 3 ]]; then
    die "nothing releasable since the last tag (only docs/test/chore commits); pass VERSION to release anyway"
  fi
  [[ -n "$suggested" ]] || die "cannot derive the version: ${suggest_out:-bin/changelog next exited $suggest_rc}"
  version="$suggested"
  derived=1
fi
tag="v$version"

# unreleased_body: the lines under "## [Unreleased]" up to the next "## [" heading.
unreleased_body() { awk '/^## \[/ { if (on) exit; on = ($0 ~ /^## \[Unreleased\]/); next } on { print }' CHANGELOG.md; }

step() { if [[ "$dry" == 1 ]]; then echo "[dry-run] would $*"; else echo "==> $*"; fi; }

if [[ "$derived" == 1 ]]; then
  echo "Release $tag ($today); version derived from conventional commits (bin/changelog next)"
else
  echo "Release $tag ($today)"
  [[ -z "$suggested" || "$suggested" == "$version" ]] || echo "note: conventional commits suggest v$suggested"
fi
if [[ "$version" == *-* ]]; then echo "This is a pre-release (version has a '-')."; else echo "This is a stable release."; fi
[[ "$dry" == 1 ]] && echo "Dry run: nothing will be committed, tagged or pushed."

# --- preconditions (read-only) ---
branch="$(git rev-parse --abbrev-ref HEAD)"
[[ "$branch" == main ]] || die "must be on main (on '$branch')"
[[ -z "$(git status --porcelain)" ]] || die "working tree is not clean; commit or stash first"
git fetch --quiet --no-tags origin || die "git fetch origin failed"
counts="$(git rev-list --left-right --count main...origin/main)" || die "cannot compare main with origin/main"
ahead="${counts%%[[:space:]]*}"
behind="${counts##*[[:space:]]}"
[[ "$behind" == 0 ]] || die "main is $behind commit(s) behind origin/main; pull first"
[[ "$ahead" == 0 ]] || echo "note: main is $ahead commit(s) ahead of origin/main; they will be pushed too"
if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then die "tag $tag already exists locally"; fi
rc=0
git ls-remote --exit-code --tags origin "refs/tags/$tag" >/dev/null 2>&1 || rc=$?
case "$rc" in
  0) die "tag $tag already exists on origin" ;;
  2) ;;
  *) die "cannot query tags on origin" ;;
esac
gh auth status >/dev/null 2>&1 || die "gh is not authenticated (run: gh auth login)"
[[ -f CHANGELOG.md ]] || die "CHANGELOG.md not found"
grep -q '^## \[Unreleased\]' CHANGELOG.md || die "CHANGELOG.md has no '## [Unreleased]' heading"
[[ -n "$(unreleased_body | tr -d '[:space:]')" ]] || die "'## [Unreleased]' in CHANGELOG.md is empty; nothing to release"
echo "Preconditions ok."

# --- checks ---
if [[ "$dry" == 1 ]]; then
  step "run bin/lint"
  step "run bin/test"
else
  step "bin/lint"
  "$REPO/bin/lint" || die "bin/lint failed"
  step "bin/test"
  "$REPO/bin/test" || die "bin/test failed"
fi

# --- changelog, commit, tag ---
step "move [Unreleased] under '## [$version] - $today' in CHANGELOG.md (leaving an empty [Unreleased])"
if [[ "$dry" == 1 ]]; then
  echo "  new section body:"
  unreleased_body | awk 'NF { started = 1 } started' | head -n 8 | sed 's/^/    | /'
else
  tmp="$(mktemp)"
  awk -v ver="$version" -v date="$today" '
    /^## \[Unreleased\]/ && !done { print; print ""; print "## [" ver "] - " date; done = 1; next }
    { print }
  ' CHANGELOG.md >"$tmp"
  cat "$tmp" >CHANGELOG.md
  rm -f "$tmp"
  if ! "$REPO/bin/release-notes" "$tag" >/dev/null; then
    git checkout -- CHANGELOG.md
    die "bin/release-notes cannot read the new section; CHANGELOG.md restored"
  fi
fi
step "git commit -m 'docs: changelog for $version' (CHANGELOG.md only)"
if [[ "$dry" == 0 ]]; then
  git add CHANGELOG.md
  git commit --quiet -m "docs: changelog for $version"
fi
step "git tag -a $tag -m $tag"
[[ "$dry" == 1 ]] || git tag -a "$tag" -m "$tag"

# --- confirm and push ---
echo
echo "Plan: git push --atomic origin main $tag, then watch the Release workflow and print the release URL."
if [[ "$dry" == 1 ]]; then
  step "ask 'Push main and $tag to origin? [y/N]' (skipped with --yes)"
  step "git push --atomic origin main $tag"
  step "wait for the Release workflow run of $tag: gh run list --workflow Release --branch $tag; gh run watch RUN_ID --exit-status"
  step "print the release URL: gh release view $tag --json url"
  echo "Dry run finished; nothing was changed."
  exit 0
fi
if [[ "$yes" == 0 ]]; then
  printf 'Push main and %s to origin? [y/N] ' "$tag"
  answer=""
  read -r answer || true
  case "$answer" in
    y | Y | yes | YES) ;;
    *)
      echo "Not pushed. The changelog commit and tag $tag exist locally only."
      echo "  push later:  git push --atomic origin main $tag"
      echo "  undo:        git tag -d $tag && git reset --hard HEAD~1"
      exit 1
      ;;
  esac
fi
step "git push --atomic origin main $tag"
git push --atomic origin main "refs/tags/$tag"

# --- watch the workflow ---
# lookup_release_run: one `gh run list` for the tag. Sets run_id (empty when none), lookup_rc and lookup_err
# (gh's stderr of this look). A failing look keeps polling like an empty one; the last one is reported.
lookup_release_run() {
  local err_file out
  err_file="$(mktemp)"
  if out="$(gh run list --workflow Release --branch "$tag" --limit 1 --json databaseId --jq '.[0].databaseId // empty' 2>"$err_file")"; then
    lookup_rc=0
  else
    lookup_rc=$?
    out=""
  fi
  lookup_err="$(cat "$err_file")"
  rm -f "$err_file"
  run_id="$out"
}

# actions_url: the repository's Actions page, from the origin URL (git@host:path or https://host/path).
actions_url() {
  local remote host path
  remote="$(git remote get-url origin 2>/dev/null || true)"
  remote="${remote%.git}"
  case "$remote" in
    git@*:*)
      host="${remote#git@}"
      host="${host%%:*}"
      path="${remote#*:}"
      ;;
    https://*/* | http://*/*)
      host="${remote#*://}"
      path="${host#*/}"
      host="${host%%/*}"
      ;;
    *) return 1 ;;
  esac
  echo "https://$host/$path/actions"
}

lookup_release_run
polls_left=$((wait_s / poll_s))
if [[ -z "$run_id" && "$polls_left" -gt 0 ]]; then echo "waiting for the Release workflow run to appear"; fi
while [[ -z "$run_id" && "$polls_left" -gt 0 ]]; do
  sleep "$poll_s"
  polls_left=$((polls_left - 1))
  lookup_release_run
done
if [[ -z "$run_id" ]]; then
  if [[ "$lookup_rc" == 0 ]]; then
    why="the last \`gh run list\` exited 0 with no run"
  else
    why="the last \`gh run list\` exited $lookup_rc: ${lookup_err:-(no output)}"
  fi
  msg="pushed $tag, but no Release workflow run appeared after $wait_s s; $why"
  msg+=$'\n'"  by hand: gh run list --workflow Release --branch $tag"
  actions="$(actions_url || true)"
  msg+=$'\n'"  Actions: ${actions:-the Actions tab of the repository}"
  die "$msg"
fi
step "gh run watch $run_id"
if ! gh run watch "$run_id" --exit-status; then
  die "the Release workflow failed (run $run_id); see: gh run view $run_id --log-failed"
fi
url="$(gh release view "$tag" --json url --jq .url)" || die "workflow passed but 'gh release view $tag' failed"
echo "Released $tag: $url"
