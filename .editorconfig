root = true

[*.go]
indent_style = tab

[*.sh]
indent_style = space
indent_size = 2
switch_case_indent = true

[bin/*]
indent_style = space
indent_size = 2
switch_case_indent = true

[adapters/*]
indent_style = space
indent_size = 2
switch_case_indent = true

[test/fixtures/*]
indent_style = space
indent_size = 2
switch_case_indent = true
