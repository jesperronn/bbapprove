#!/usr/bin/env bash
# shellcheck shell=bash
# bitbucket adapter — gh-style CLI over the Bitbucket Server REST API. The only place that knows about curl/Bitbucket.
#
#   bitbucket auth token                        print the API token (BBAPPROVE_TOKEN, else the 1Password item BBAPPROVE_TOKEN_NAME)
#   bitbucket pr list --reviewer @me --state open   JSON array of normalized PRs
#   bitbucket pr view URL                       one normalized PR as compact JSON
#   bitbucket pr review URL --approve           approve
#   bitbucket pr merge URL                      merge (retries when the PR version went stale), then delete the source branch
#                                               unless BBAPPROVE_DELETE_SOURCE_BRANCH=false (fork PRs and non-branch refs are never touched;
#                                               a failed deletion only warns on stderr, the merge still succeeds)
#   bitbucket pr comment URL --body TEXT        post a comment (or --body-file FILE)
#   bitbucket pr close URL [--comment TEXT]     decline the PR; --comment is posted first, and a failed comment aborts the decline
#
# Normalized PR: {url, number, project, repo, title, author:{email,login}, headBranch, approvedByMe,
#   build: passed|failed|running|none, qualityGate: passed|failed|unknown,
#   approvals, needsWork (reviewer counts), commentCount, openTasks, state: OPEN|MERGED|DECLINED}
# Errors: message on stderr, non-zero exit. Env: BBAPPROVE_BASE_URL (required, no default), BBAPPROVE_TOKEN (required by every pr command; exit 2 when unset), BBAPPROVE_TOKEN_NAME (1Password item for `auth token`, no default), BBAPPROVE_MERGE_RETRIES, BBAPPROVE_RETRY_SLEEP, BBAPPROVE_DELETE_SOURCE_BRANCH (true|false, default true).

set -euo pipefail

BASE_URL="${BBAPPROVE_BASE_URL:-}"
TOKEN_NAME="${BBAPPROVE_TOKEN_NAME:-}"
TOKEN="${BBAPPROVE_TOKEN:-}"
MERGE_RETRIES="${BBAPPROVE_MERGE_RETRIES:-4}"
RETRY_SLEEP="${BBAPPROVE_RETRY_SLEEP:-2}"
DELETE_SOURCE_BRANCH="${BBAPPROVE_DELETE_SOURCE_BRANCH:-true}"
CURL_CONNECT_TIMEOUT=2.7 # seconds
CURL_MAX_TIME=3.5        # seconds, per curl call

err() { printf '%s\n' "$*" >&2; }

LAST_CODE="" API_BODY=""
api() { # method endpoint [data] -> API_BODY, LAST_CODE; returns 1 when curl itself failed (code 000)
  local method="$1" endpoint="$2" data="${3:-}" out
  local args=(--connect-timeout "$CURL_CONNECT_TIMEOUT" --max-time "$CURL_MAX_TIME" -sS -w $'\n%{http_code}' -X "$method" -H "Authorization: Bearer $TOKEN" -H "Accept: application/json")
  [[ -n "$data" ]] && args+=(-H "Content-Type: application/json" -d "$data")
  if ! out="$(curl "${args[@]}" "$BASE_URL$endpoint")"; then
    LAST_CODE="000"
    API_BODY=""
    return 1
  fi
  LAST_CODE="$(printf '%s' "$out" | tail -n1)"
  API_BODY="$(printf '%s' "$out" | sed '$d')"
}

parse_pr_url() { # url -> "KEY REPO ID"
  [[ "$1" =~ /projects/([^/]+)/repos/([^/]+)/pull-requests/([0-9]+) ]] || {
    err "Not a PR URL: $1"
    return 2
  }
  printf '%s %s %s' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
}

# normalize: raw Bitbucket PR object on stdin -> normalized compact JSON.
# Uses ME (whoami slug) and STATS (JSON map: commit sha -> build-status counts).
normalize() {
  jq -c --arg base "$BASE_URL" --arg me "${ME:-}" --argjson stats "${STATS:-{\}}" '
    ([.reviewers[]?, .participants[]?]) as $people
    | ($stats[.fromRef.latestCommit // ""] // {}) as $b
    | {
    url: "\($base)/projects/\(.toRef.repository.project.key)/repos/\(.toRef.repository.slug)/pull-requests/\(.id)",
    number: .id,
    project: .toRef.repository.project.key,
    repo: .toRef.repository.slug,
    title: .title,
    author: {email: (.author.user.emailAddress // ""), login: (.author.user.slug // "")},
    headBranch: (.fromRef.displayId // ""),
    approvedByMe: ($me != "" and ([$people[] | select(.user.slug==$me and .status=="APPROVED")] | length) > 0),
    build: (if ($b.failed // 0) > 0 then "failed" elif ($b.inProgress // 0) > 0 then "running" elif ($b.successful // 0) > 0 then "passed" else "none" end),
    qualityGate: ((.properties.qgStatus // "UNKNOWN") | ascii_downcase | if . == "passed" or . == "failed" then . else "unknown" end),
    approvals: ([.reviewers[]? | select(.status=="APPROVED")] | length),
    needsWork: ([.reviewers[]? | select(.status=="NEEDS_WORK")] | length),
    commentCount: (.properties.commentCount // 0),
    openTasks: (.properties.openTaskCount // 0),
    state: (.state // "OPEN")
  }'
}

load_me() {
  ME=""
  api GET "/plugins/servlet/applinks/whoami" || true
  [[ "$LAST_CODE" == 200 ]] && ME="$(tr -d '[:space:]' <<<"$API_BODY")"
  return 0
}

cmd_auth_token() {
  if [[ -z "$TOKEN" && -n "$TOKEN_NAME" ]]; then
    command -v op >/dev/null 2>&1 || {
      err "1Password CLI (op) not found; set BBAPPROVE_TOKEN instead"
      return 1
    }
    local dim="" reset="" field
    if [[ -z "${NO_COLOR:-}" && (-t 2 || -n "${FORCE_COLOR:-}") ]]; then dim=$'\033[2m' reset=$'\033[0m'; fi
    err "${dim}Waiting for 1Password: op item get ${TOKEN_NAME}${reset}"
    for field in token credential; do
      TOKEN="$(op item get "$TOKEN_NAME" --reveal --fields "label=$field" 2>/dev/null)" || TOKEN=""
      [[ -n "$TOKEN" ]] && break
    done
  fi
  [[ -n "$TOKEN" ]] || {
    err "No token: set BBAPPROVE_TOKEN, or BBAPPROVE_TOKEN_NAME to a 1Password item with a token or credential field."
    return 1
  }
  printf '%s\n' "$TOKEN"
}

cmd_pr_list() { # only --reviewer @me --state open is supported
  local start=0 all='[]'
  load_me
  while :; do
    api GET "/rest/api/1.0/dashboard/pull-requests?role=REVIEWER&state=OPEN&limit=100&start=$start&withProperties=true&withAttributes=true" || true
    [[ "$LAST_CODE" == 200 ]] || {
      err "Dashboard fetch failed ($LAST_CODE)"
      return 1
    }
    all="$(jq -c --argjson more "$(jq -c '[.values[]]' <<<"$API_BODY")" '. + $more' <<<"$all")"
    [[ "$(jq -r '.isLastPage' <<<"$API_BODY")" == "true" ]] && break
    start="$(jq -r '.nextPageStart' <<<"$API_BODY")"
  done
  load_stats "$(jq -c '[.[].fromRef.latestCommit] | map(select(. != null))' <<<"$all")"
  jq -c '.[]' <<<"$all" | normalize_lines | jq -sc '.'
}

# load_stats SHAS_JSON: one batched call for build status of all commits; failure just means "none".
load_stats() {
  STATS="{}"
  [[ "$1" != "[]" ]] || return 0
  if api POST "/rest/build-status/1.0/commits/stats" "$1" && [[ "$LAST_CODE" == 200 ]]; then STATS="$API_BODY"; fi
  return 0
}

normalize_lines() { while IFS= read -r l; do normalize <<<"$l"; done; }

cmd_pr_view() {
  local key repo id parts
  parts="$(parse_pr_url "$1")" || return 2
  read -r key repo id <<<"$parts"
  load_me
  api GET "/rest/api/1.0/projects/$key/repos/$repo/pull-requests/$id" || true
  [[ "$LAST_CODE" == 200 ]] || {
    err "Fetch failed ($LAST_CODE): $1"
    return 1
  }
  local raw="$API_BODY" comments
  load_stats "$(jq -c '[.fromRef.latestCommit] | map(select(. != null))' <<<"$raw")"
  # A single-PR GET carries no properties. A task is a blocker comment: count open tasks from
  # /blocker-comments and report comments excluding tasks, as the dashboard's commentCount does.
  local activity tasks_all tasks_open
  api GET "/rest/api/1.0/projects/$key/repos/$repo/pull-requests/$id/activities?limit=100" || true
  activity="$(jq -r '[.values[]? | select(.action=="COMMENTED")] | length' <<<"$API_BODY" 2>/dev/null || echo 0)"
  api GET "/rest/api/1.0/projects/$key/repos/$repo/pull-requests/$id/blocker-comments?limit=100" || true
  tasks_all="$(jq -r '[.values[]?] | length' <<<"$API_BODY" 2>/dev/null || echo 0)"
  tasks_open="$(jq -r '[.values[]? | select(.state=="OPEN")] | length' <<<"$API_BODY" 2>/dev/null || echo 0)"
  comments=$((${activity:-0} - ${tasks_all:-0}))
  ((comments >= 0)) || comments=0
  jq -c --argjson c "$comments" --argjson t "${tasks_open:-0}" \
    '.properties = ((.properties // {}) + {commentCount: $c, openTaskCount: $t})' <<<"$raw" | normalize
}

cmd_pr_review() { # URL --approve
  local url="$1" key repo id parts
  [[ "${2:-}" == "--approve" ]] || {
    err "pr review: only --approve is supported"
    return 2
  }
  parts="$(parse_pr_url "$url")" || return 2
  read -r key repo id <<<"$parts"
  api POST "/rest/api/1.0/projects/$key/repos/$repo/pull-requests/$id/approve" || true
  [[ "$LAST_CODE" == 2* ]] || {
    err "approve HTTP $LAST_CODE"
    return 1
  }
}

# delete_source_branch SOURCE_REF_ID: remove the merged PR's source branch. Never fails the caller: a deletion
# that did not work (other than "already gone") only draws a warning, because the merge itself has succeeded.
delete_source_branch() {
  local ref="$1" payload
  payload="$(jq -nc --arg n "$ref" '{name: $n, dryRun: false}')"
  api DELETE "/rest/branch-utils/1.0/projects/$2/repos/$3/branches" "$payload" || true
  [[ "$LAST_CODE" == 2* || "$LAST_CODE" == 404 ]] && return 0
  err "merge ok, but could not delete branch ${ref#refs/heads/} (HTTP $LAST_CODE)"
  return 0
}

cmd_pr_merge() { # URL
  local key repo id parts base attempt=0 fresh want
  want="$(tr '[:upper:]' '[:lower:]' <<<"$DELETE_SOURCE_BRANCH")"
  case "$want" in
    true | 1 | yes) want=1 ;;
    false | 0 | no) want=0 ;;
    *)
      err "pr merge: BBAPPROVE_DELETE_SOURCE_BRANCH must be true or false, got: $DELETE_SOURCE_BRANCH"
      return 2
      ;;
  esac
  parts="$(parse_pr_url "$1")" || return 2
  read -r key repo id <<<"$parts"
  base="/rest/api/1.0/projects/$key/repos/$repo/pull-requests/$id"
  # Re-fetch the version right before merging: earlier merges in the same repo move the
  # target branch and bump the PR version, so a version read earlier goes stale.
  local refs from_ref from_key from_repo to_key to_repo to_ref
  while :; do
    attempt=$((attempt + 1))
    api GET "$base" || true
    fresh="$(jq -r '.version // empty' <<<"$API_BODY" 2>/dev/null || true)"
    [[ -n "$fresh" ]] || {
      err "merge: could not read PR version (HTTP $LAST_CODE)"
      return 1
    }
    # Source and target of the PR as of this attempt, read before the merge POST overwrites API_BODY.
    refs="$(jq -r '[.fromRef.id // "", .fromRef.repository.project.key // "", .fromRef.repository.slug // "",
      .toRef.repository.project.key // "", .toRef.repository.slug // "", .toRef.id // ""] | join("\u001f")' <<<"$API_BODY" 2>/dev/null || true)"
    IFS=$'\x1f' read -r from_ref from_key from_repo to_key to_repo to_ref <<<"$refs" || true
    api POST "$base/merge?version=$fresh" "{\"version\":$fresh}" || true
    if [[ "$LAST_CODE" == 2* ]]; then
      # Only a branch of the PR's own repository, and not the target itself; a fork's branch is not ours to delete.
      if ((want)) && [[ "$from_ref" == refs/heads/* && "$from_ref" != "$to_ref" && "$from_key" == "$to_key" && "$from_repo" == "$to_repo" && -n "$to_repo" ]]; then
        delete_source_branch "$from_ref" "$to_key" "$to_repo"
      fi
      return 0
    fi
    if [[ "$LAST_CODE" == 409 && ("$API_BODY" == *"out-of-date"* || "$API_BODY" == *"New changes were pushed"*) ]] && ((attempt < MERGE_RETRIES)); then
      sleep "$RETRY_SLEEP"
      continue
    fi
    break
  done
  err "merge HTTP $LAST_CODE: $(jq -r '[.errors[]?.message] | join("; ")' <<<"$API_BODY" 2>/dev/null || true)"
  return 1
}

comment_pr() { # KEY REPO ID TEXT -> posts one PR comment; stderr + 1 on failure
  local key="$1" repo="$2" id="$3" text="$4" payload
  payload="$(jq -n --arg t "$text" '{text: $t}')"
  api POST "/rest/api/1.0/projects/$key/repos/$repo/pull-requests/$id/comments" "$payload" || true
  [[ "$LAST_CODE" == 2* ]] || {
    err "comment HTTP $LAST_CODE"
    return 1
  }
}

cmd_pr_comment() { # URL --body TEXT | --body-file FILE
  local url="${1:-}" body="" have_body=0 body_file="" key repo id parts
  parts="$(parse_pr_url "$url")" || return 2
  read -r key repo id <<<"$parts"
  shift
  while (($#)); do
    case "$1" in
      --body)
        [[ $# -ge 2 ]] || {
          err "pr comment: --body needs a value"
          return 2
        }
        body="$2"
        have_body=1
        shift 2
        ;;
      --body-file)
        [[ $# -ge 2 ]] || {
          err "pr comment: --body-file needs a value"
          return 2
        }
        body_file="$2"
        shift 2
        ;;
      *)
        err "pr comment: unknown argument: $1"
        return 2
        ;;
    esac
  done
  if [[ -n "$body_file" ]]; then
    ((have_body == 0)) || {
      err "pr comment: use either --body or --body-file, not both"
      return 2
    }
    body="$(cat -- "$body_file")" || {
      err "pr comment: cannot read $body_file"
      return 2
    }
  fi
  [[ -n "${body//[[:space:]]/}" ]] || {
    err "pr comment: empty comment (use --body TEXT or --body-file FILE)"
    return 2
  }
  comment_pr "$key" "$repo" "$id" "$body"
}

cmd_pr_close() { # URL [--comment TEXT]
  local url="${1:-}" comment="" have_comment=0 key repo id parts base fresh
  parts="$(parse_pr_url "$url")" || return 2
  read -r key repo id <<<"$parts"
  shift
  while (($#)); do
    case "$1" in
      --comment)
        [[ $# -ge 2 ]] || {
          err "pr close: --comment needs a value"
          return 2
        }
        comment="$2"
        have_comment=1
        shift 2
        ;;
      *)
        err "pr close: unknown argument: $1"
        return 2
        ;;
    esac
  done
  if ((have_comment)); then
    [[ -n "${comment//[[:space:]]/}" ]] || {
      err "pr close: --comment must not be empty"
      return 2
    }
    # Comment first: if it fails, do not decline, so a close is never silent.
    comment_pr "$key" "$repo" "$id" "$comment" || {
      err "close aborted: comment failed, PR not declined"
      return 1
    }
  fi
  base="/rest/api/1.0/projects/$key/repos/$repo/pull-requests/$id"
  # Decline needs the current PR version, so read it right before the call.
  api GET "$base" || true
  fresh="$(jq -r '.version // empty' <<<"$API_BODY" 2>/dev/null || true)"
  [[ -n "$fresh" ]] || {
    err "close: could not read PR version (HTTP $LAST_CODE)"
    return 1
  }
  api POST "$base/decline?version=$fresh" "{\"version\":$fresh}" || true
  [[ "$LAST_CODE" == 2* ]] && return 0
  err "decline HTTP $LAST_CODE: $(jq -r '[.errors[]?.message] | join("; ")' <<<"$API_BODY" 2>/dev/null || true)"
  return 1
}

main() {
  [[ -n "$BASE_URL" ]] || {
    err "bitbucket adapter: BBAPPROVE_BASE_URL is not set"
    return 2
  }
  local group="${1:-}" sub="${2:-}"
  if [[ "$group $sub" != "auth token" && -z "$TOKEN" ]]; then
    err "bitbucket adapter: BBAPPROVE_TOKEN is not set"
    return 2
  fi
  case "$group $sub" in
    "auth token") cmd_auth_token ;;
    "pr list")
      shift 2
      cmd_pr_list "$@"
      ;;
    "pr view")
      shift 2
      cmd_pr_view "$@"
      ;;
    "pr review")
      shift 2
      cmd_pr_review "$@"
      ;;
    "pr merge")
      shift 2
      cmd_pr_merge "$@"
      ;;
    "pr comment")
      shift 2
      cmd_pr_comment "$@"
      ;;
    "pr close")
      shift 2
      cmd_pr_close "$@"
      ;;
    *)
      err "usage: bitbucket auth token | pr list|view|review|merge|comment|close ..."
      return 2
      ;;
  esac
}

main "$@"
