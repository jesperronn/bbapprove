#!/usr/bin/env bash
# A fake bash suite for the bin/test tests: symlink it as NAME.test.sh. Logs "suite NAME ARGS" to $TESTSH_TEST_LOG
# sleeps $FAKE_SLOW_B seconds when NAME is b.test.sh, and exits 1 when NAME is $FAKE_FAIL_SUITE.
# With BASH_TEST_TIMING_FILE set it appends one test line (seconds $FAKE_TEST_SECONDS, default 0.5) like bash_test.sh.
echo "suite $(basename "$0")${*:+ $*}" >>"$TESTSH_TEST_LOG"
if [[ -n "${BASH_TEST_TIMING_FILE:-}" ]]; then
  printf '%s\t%s\t%s\n' "${FAKE_TEST_SECONDS:-0.5}" "$(basename "$0")" test_fake >>"$BASH_TEST_TIMING_FILE"
fi
if [[ "$(basename "$0")" == "b.test.sh" ]]; then sleep "${FAKE_SLOW_B:-0}"; fi
if [[ "$(basename "$0")" == "${FAKE_FAIL_SUITE:-}" ]]; then
  exit 1
fi
