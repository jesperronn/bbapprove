#!/usr/bin/env bash
# shellcheck shell=bash
# workflows — list every command in bin/ with its one-line description and the standard flow
#
# Usage: bin/workflows
# The descriptions are scraped from the "# <name> — <description>" comment near the top of each
# script, so this list cannot go stale.

set -euo pipefail

SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
  target="$(readlink "$SELF")"
  if [[ "$target" == /* ]]; then SELF="$target"; else SELF="$(dirname "$SELF")/$target"; fi
done
REPO="$(cd "$(dirname "$SELF")/.." && pwd -P)"
# shellcheck source=lib/style.sh
source "$REPO/bin/lib/style.sh"

usage_text() {
  echo "Usage: bin/workflows"
  echo "Lists every command in bin/ with a one-line description."
}

usage() { usage_text | style_help; }

case "${1:-}" in
  "") ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "workflows: unknown option: $1" >&2
    usage >&2
    exit 2
    ;;
esac

paint title 1 "bbapprove maintainer commands (bin/):"
echo
echo
for f in "$REPO"/bin/*; do
  [[ -f "$f" && -x "$f" ]] || continue
  name="$(basename "$f")"
  # Skip compiled files such as bin/bbapprove-go: only scripts have a shebang.
  [[ "$(head -c 2 "$f")" == "#!" ]] || continue
  desc="$(grep -m1 "^# $name — " "$f" | cut -d' ' -f4- || true)"
  printf '  %s %s\n' "$(paint cmd 1 "$(printf '%-14s' "$name")")" "${desc:-(no description line)}"
done
{
  cat <<'FLOW'

Standard flow:
  bin/setup               check tools, download modules, build        (once per clone)
  bin/test                run the Go and shell test suites            (bin/lint checks style)
  bin/deps                list outdated Go modules; --patch|--minor|--major updates (never commits)
  bin/install             build and link bbapprove into ~/.local/bin
  bin/release X.Y.Z       changelog, tag, push, watch the release workflow
Every command takes --help.
FLOW
} | style_help
