# bbapprove configuration. Copy to bbapprove.config.toml (git-ignored) and edit:
#   cp bbapprove.config.template bbapprove.config.toml
#
# Lookup order: --config FILE, $BBAPPROVE_CONFIG, <repo>/bbapprove.config.toml,
# $XDG_CONFIG_HOME/bbapprove/config.toml (default ~/.config/bbapprove/config.toml).
# Precedence per setting: command line > environment (BBAPPROVE_*) > this file > built-in default.
# Check the result with: bbapprove --print-config

# which forge adapter to use: adapters/<type> (bitbucket today). Default: "bitbucket"
type = "bitbucket"

# base URL of the forge (no built-in default; required). Env: BBAPPROVE_REPOSITORY
repository = "https://bitbucket.example.com"

# optional: name of a 1Password item holding the API token (field "token", else "credential"), looked up with
# "op". No built-in default. BBAPPROVE_TOKEN, when set, always wins and the item is not looked up.
# Env: BBAPPROVE_TOKEN_NAME; the command line (--token-name NAME) wins over the file.
# user_token_name = "my-1password-item"

# only PRs authored by this bot are eligible (no built-in default; required). Env: BBAPPROVE_AUTHOR_EMAIL
author_email = "renovate-bot@example.com"

# dependencies bbapprove must never auto-approve (case-insensitive substrings of the PR title).
# Merged with --disallow / BBAPPROVE_DISALLOW.
disallow = ["some-library", "another-library"]

# optional: GitHub owner/repo that "bbapprove --outdated" and "--update" check for releases.
# Default: "jesperronn/bbapprove". Env: BBAPPROVE_UPDATE_REPO
# update_repo = "jesperronn/bbapprove"
