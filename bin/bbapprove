#!/usr/bin/env bash
# shellcheck shell=bash
# bbapprove — launcher: rebuilds bin/bbapprove-go when stale, then runs it (the command users install)
#
# Rebuilds the Go binary when missing or older than the Go sources, then execs it with every
# argument unchanged.

set -euo pipefail

# Resolve symlinks without readlink -f (not available on macOS).
SELF="$0"
while [[ -L "$SELF" ]]; do
  target="$(readlink "$SELF")"
  if [[ "$target" == /* ]]; then SELF="$target"; else SELF="$(dirname "$SELF")/$target"; fi
done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
BIN="$ROOT/bin/bbapprove-go"

# Rebuild when the binary is missing or any go.mod, go.sum or *.go file is newer than it.
needs_build() {
  [[ -x "$BIN" ]] || return 0
  local -a roots=("$ROOT/go.mod" "$ROOT/cmd" "$ROOT/internal")
  [[ -f "$ROOT/go.sum" ]] && roots+=("$ROOT/go.sum")
  [[ -n "$(find "${roots[@]}" -type f \( -name go.mod -o -name go.sum -o -name '*.go' \) -newer "$BIN" -print -quit 2>/dev/null)" ]]
}

if needs_build; then
  if ! command -v go >/dev/null 2>&1; then
    echo "bbapprove: needs Go to build (https://go.dev/dl/)" >&2
    exit 127
  fi
  "$ROOT/bin/build" -o "$BIN" >&2
fi

exec "$BIN" "$@"
