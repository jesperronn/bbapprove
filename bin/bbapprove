#!/usr/bin/env bash
# shellcheck shell=bash
# bbapprove — approve and merge eligible Renovate PRs on Bitbucket Server (dry-run unless --apply).

set -euo pipefail

BBAPPROVE_BASE_URL="${BBAPPROVE_BASE_URL:-https://bitbucket.example.com}"
BBAPPROVE_AUTHOR_EMAIL="${BBAPPROVE_AUTHOR_EMAIL:-renovate-bot@example.com}"
BBAPPROVE_DISALLOW="${BBAPPROVE_DISALLOW:-some-library}"   # comma-separated, case-insensitive substrings
BBAPPROVE_TOKEN="${BBAPPROVE_TOKEN:-}"
BBAPPROVE_APPLY=0
BBAPPROVE_TARGETS=()

usage() {
  cat <<'USAGE'
bbapprove — approve and merge Renovate PRs on Bitbucket Server.

Usage: bbapprove [--apply] [--disallow a,b] [--token T] [PR_URL...]

With no PR_URL, every open PR where you are a reviewer is considered.
Without --apply nothing is changed; eligibility is only reported.

A PR is eligible when ALL hold:
  - author email is renovate-bot@example.com
  - title starts with "chore(deps):" or "fix(deps):"
  - title does not mention a disallowed dependency (default: some-library)
  - update is minor/patch/digest (title "to vN" only, or branch renovate/major-*, is major)

Env: BBAPPROVE_BASE_URL, BBAPPROVE_AUTHOR_EMAIL, BBAPPROVE_DISALLOW, BBAPPROVE_TOKEN.
Token falls back to 1Password item BITBUCKET_TOKEN (same as bbpr).
USAGE
}

log() { printf '%s\n' "$*"; }
err() { printf '%s\n' "$*" >&2; }

fetch_token() {
  if [[ -z "$BBAPPROVE_TOKEN" ]] && command -v op >/dev/null 2>&1; then
    BBAPPROVE_TOKEN="$(op item get BITBUCKET_TOKEN --fields label=token --reveal 2>/dev/null)" || BBAPPROVE_TOKEN=""
  fi
  [[ -n "$BBAPPROVE_TOKEN" ]] || { err "No token: use --token, BBAPPROVE_TOKEN or 1Password (op)."; return 1; }
}

LAST_CODE=""
api() { # method endpoint [data] -> body on stdout, http code in LAST_CODE (call without subshell via api_to)
  local method="$1" endpoint="$2" data="${3:-}" out
  local args=(-sS -w $'\n%{http_code}' -X "$method" -H "Authorization: Bearer $BBAPPROVE_TOKEN" -H "Accept: application/json")
  [[ -n "$data" ]] && args+=(-H "Content-Type: application/json" -d "$data")
  out="$(curl "${args[@]}" "$BBAPPROVE_BASE_URL$endpoint")"
  LAST_CODE="$(printf '%s' "$out" | tail -n1)"
  API_BODY="$(printf '%s' "$out" | sed '$d')"
}

# eligibility: prints reason and returns 1 when not eligible
check_eligible() {
  local pr="$1" email title branch lower_title item
  email="$(jq -r '.author.user.emailAddress // ""' <<<"$pr")"
  title="$(jq -r '.title' <<<"$pr")"
  branch="$(jq -r '.fromRef.displayId // ""' <<<"$pr")"
  if [[ "$email" != "$BBAPPROVE_AUTHOR_EMAIL" ]]; then echo "author '$email' is not the renovate bot"; return 1; fi
  if [[ ! "$title" =~ ^(chore|fix)\(deps\):\  ]]; then echo "subject does not start with chore(deps): or fix(deps):"; return 1; fi
  lower_title="$(tr '[:upper:]' '[:lower:]' <<<"$title")"
  IFS=',' read -ra items <<<"$BBAPPROVE_DISALLOW"
  for item in "${items[@]}"; do
    item="$(tr '[:upper:]' '[:lower:]' <<<"${item// /}")"
    [[ -n "$item" && "$lower_title" == *"$item"* ]] && { echo "disallowed dependency '$item'"; return 1; }
  done
  if [[ "$branch" == renovate/major-* || "$title" =~ \ to\ v?[0-9]+\ *(\(.*\))?$ ]]; then echo "major update"; return 1; fi
  if [[ -n "${ME:-}" && "$(jq -r --arg me "$ME" '[.participants[]? | select(.user.slug==$me and .status=="APPROVED")] | length' <<<"$pr")" -gt 0 ]]; then
    echo "already approved by me"; return 1
  fi
  return 0
}

process_pr() { # PR json
  local pr="$1" key repo id version label reason
  key="$(jq -r '.toRef.repository.project.key' <<<"$pr")"
  repo="$(jq -r '.toRef.repository.slug' <<<"$pr")"
  id="$(jq -r '.id' <<<"$pr")"
  version="$(jq -r '.version' <<<"$pr")"
  label="$key/$repo#$id $(jq -r '.title' <<<"$pr")"
  if ! reason="$(check_eligible "$pr")"; then log "SKIP    $label — $reason"; return 0; fi
  if (( ! BBAPPROVE_APPLY )); then log "ELIGIBLE $label (dry-run)"; return 0; fi

  local base="/rest/api/1.0/projects/$key/repos/$repo/pull-requests/$id"
  api POST "$base/approve"
  if [[ "$LAST_CODE" != 2* ]]; then log "FAIL    $label — approve HTTP $LAST_CODE"; return 0; fi
  api POST "$base/merge?version=$version" "{\"version\":$version}"
  if [[ "$LAST_CODE" == 2* ]]; then
    log "MERGED  $label"
  else
    log "APPROVED, NOT MERGED $label — merge HTTP $LAST_CODE: $(jq -r '[.errors[]?.message] | join("; ")' <<<"$API_BODY" 2>/dev/null || true)"
  fi
}

parse_pr_url() { # url -> "KEY REPO ID"
  if [[ "$1" =~ /projects/([^/]+)/repos/([^/]+)/pull-requests/([0-9]+) ]]; then
    printf '%s %s %s' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
  else
    return 1
  fi
}

main() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage; return 0 ;;
      --apply) BBAPPROVE_APPLY=1; shift ;;
      --disallow) BBAPPROVE_DISALLOW="$2"; shift 2 ;;
      --token) BBAPPROVE_TOKEN="$2"; shift 2 ;;
      -*) err "Unknown option: $1"; usage >&2; return 2 ;;
      *) BBAPPROVE_TARGETS+=("$1"); shift ;;
    esac
  done
  command -v jq >/dev/null || { err "jq is required"; return 1; }
  fetch_token

  api GET "/plugins/servlet/applinks/whoami" || true
  ME=""; [[ "$LAST_CODE" == 200 ]] && ME="$(tr -d '[:space:]' <<<"$API_BODY")"

  local prs=() t parts key repo id start=0 last page
  if (( ${#BBAPPROVE_TARGETS[@]} )); then
    for t in "${BBAPPROVE_TARGETS[@]}"; do
      parts="$(parse_pr_url "$t")" || { err "Not a PR URL: $t"; return 2; }
      read -r key repo id <<<"$parts"
      api GET "/rest/api/1.0/projects/$key/repos/$repo/pull-requests/$id"
      [[ "$LAST_CODE" == 200 ]] || { err "Fetch failed ($LAST_CODE): $t"; return 1; }
      prs+=("$API_BODY")
    done
  else
    while :; do
      api GET "/rest/api/1.0/dashboard/pull-requests?role=REVIEWER&state=OPEN&limit=100&start=$start"
      [[ "$LAST_CODE" == 200 ]] || { err "Dashboard fetch failed ($LAST_CODE)"; return 1; }
      while IFS= read -r page; do prs+=("$page"); done < <(jq -c '.values[]' <<<"$API_BODY")
      last="$(jq -r '.isLastPage' <<<"$API_BODY")"
      [[ "$last" == "true" ]] && break
      start="$(jq -r '.nextPageStart' <<<"$API_BODY")"
    done
  fi

  local pr
  for pr in ${prs[@]+"${prs[@]}"}; do process_pr "$pr"; done
  (( BBAPPROVE_APPLY )) || log "Dry run — pass --apply to approve and merge."
}

main "$@"
